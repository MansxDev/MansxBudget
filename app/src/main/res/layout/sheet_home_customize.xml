<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.08"
            android:text="@string/prefs_eyebrow"
            android:textAllCaps="true"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/home_customize"
            android:textAppearance="@style/TextAppearance.MansxHeadline"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chk_saldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_saldo" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chk_quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_quick" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chk_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_plan" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chk_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_calendar" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chk_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_chart" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chk_budget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_budget" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chk_last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_last" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/border_color" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.08"
            android:text="@string/horizon_eyebrow"
            android:textAllCaps="true"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_horizon_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_horizon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0"
            android:valueFrom="7"
            android:valueTo="90" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/home_reset"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/home_save"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>