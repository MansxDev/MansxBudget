<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_debt_sheet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/debt_form_title_add"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_debtor"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/debt_hint_name"
            android:inputType="text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/debt_label_kind"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_debt_mine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="@string/debt_kind_mine" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_debt_theirs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debt_kind_theirs" />
        </RadioGroup>

        <EditText
            android:id="@+id/et_debt_total"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/debt_hint_total"
            android:inputType="number"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_debt_paid"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/debt_hint_paid"
            android:inputType="number"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_debt_purpose"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/debt_hint_purpose"
            android:inputType="text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/debt_label_date"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_debt_date"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_save_debt"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_save" />

        <Button
            android:id="@+id/btn_delete_debt"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_delete"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="@color/btn_danger" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
