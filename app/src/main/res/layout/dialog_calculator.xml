<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/calculator_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Display Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_calculator_display"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvCalcExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCalcResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:text="0"
            android:textColor="?attr/colorOnSurface"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad Grid -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <!-- Row 1 -->
        <TableRow android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnCalcClear"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_button_danger"
                android:text="C"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCalcDel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_button_secondary"
                android:text="DEL"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCalcDiv"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn_op"
                android:text="÷"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCalcMul"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn_op"
                android:text="×"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </TableRow>

        <!-- Row 2 -->
        <TableRow android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnCalc7"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="7"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalc8"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="8"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalc9"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="9"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalcSub"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn_op"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </TableRow>

        <!-- Row 3 -->
        <TableRow android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnCalc4"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="4"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalc5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="5"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalc6"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="6"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalcAdd"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn_op"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </TableRow>

        <!-- Row 4 -->
        <TableRow android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnCalc1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalc2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalc3"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="3"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalcEqual"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_button_primary"
                android:text="="
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </TableRow>

        <!-- Row 5 -->
        <TableRow>
            <Button
                android:id="@+id/btnCalc0"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="0"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnCalcDot"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_calculator_btn"
                android:text="."
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCalcUseResult"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_span="2"
                android:layout_margin="2dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_use_result"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </TableRow>
    </TableLayout>

    <Button
        android:id="@+id/btnCalcClose"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_secondary"
        android:text="@string/btn_close"
        android:textColor="@color/white" />

</LinearLayout>
