<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Holo.Light">
	</style>

    <!-- Plus Jakarta Sans display styles: headline (ExtraBold) & money (Black weight ~800) -->
    <style name="TextAppearance" />

    <style name="TextAppearance.MansxHeadline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/pjs_extrabold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.MansxMoney">
        <item name="android:fontFamily">@font/pjs_black</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.MansxMoneyBig">
        <item name="android:fontFamily">@font/pjs_black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
</resources>